# ============================================================================
#  灵犀伴行 PC 用户端 — HTTPS 入口
#  ---------------------------------------------------------------------------
#  文件名以 .disabled 结尾，因此不会被 nginx 的 include *.conf 加载。
#  证书签发成功后执行 deploy/nginx/enable-https.sh：
#    1) 重命名去掉 .disabled
#    2) 把 lingxi-app.conf 的 80 端口块改为 308 跳转到 https
#    3) nginx -t && nginx -s reload
# ============================================================================

server {
    listen 80;
    server_name app.mingusone.com;

    root /usr/share/nginx/html/lingxi-app/dist;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.mingusone.com;

    ssl_certificate /etc/letsencrypt/live/app.mingusone.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.mingusone.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /usr/share/nginx/html/lingxi-app/dist;
    index index.html;

    client_max_body_size 100m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://lingxi-admin:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection '';
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_cache off;
        add_header X-Accel-Buffering no;
    }

    location /actuator/ {
        proxy_pass http://lingxi-admin:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /profile/ {
        proxy_pass http://lingxi-admin:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}