<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>com.lingxi</groupId><artifactId>lingxi-server</artifactId><version>1.0.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
    <artifactId>lingxi-boot</artifactId>
    <name>LingXi Companion Boot</name>
    <dependencies>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-kernel</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-identity</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-goal</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-companion</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-engagement</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-relationship</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-content</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-commerce</artifactId></dependency>
        <dependency><groupId>com.lingxi</groupId><artifactId>lingxi-module-operations</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
