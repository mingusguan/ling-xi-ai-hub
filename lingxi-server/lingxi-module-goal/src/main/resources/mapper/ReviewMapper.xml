<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingxi.goal.infrastructure.persistence.ReviewMapper">
    <insert id="insertIgnoreBatch">
        INSERT IGNORE INTO goal_review
        (id,goal_id,period_key,input_snapshot_json,status,conclusion_json,
         completion_request_key,completion_request_digest,version,created_at,completed_at) VALUES
        <foreach collection="items" item="i" separator=",">
            (#{i.id},#{i.goalId},#{i.periodKey},#{i.inputSnapshotJson},#{i.status},#{i.conclusionJson},
             #{i.completionRequestKey},#{i.completionRequestDigest},#{i.version},#{i.createdAt},#{i.completedAt})
        </foreach>
    </insert>
</mapper>
