<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingxi.goal.infrastructure.persistence.MilestoneMapper">
    <insert id="insertBatch">
        INSERT INTO goal_milestone (id,plan_version_id,sequence_no,title,success_criteria,created_at) VALUES
        <foreach collection="items" item="i" separator=",">
            (#{i.id},#{i.planVersionId},#{i.sequenceNo},#{i.title},#{i.successCriteria},#{i.createdAt})
        </foreach>
    </insert>
</mapper>
